{
  "rewrites": [
    { "source": "/", "destination": "/ozkiz-shoes-v3.html" }
  ],
  "functions": {
    "api/products.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
